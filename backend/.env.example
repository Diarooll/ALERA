DJANGO_DEBUG=true
DJANGO_SECRET_KEY=chavedodjango
# Banco do docker-compose.yml (na raiz do projeto). Sem esta linha, usa o SQLite local
DATABASE_URL=postgres://alera:alera-local@127.0.0.1:5432/alera

# Só na hospedagem (com DJANGO_DEBUG=false). Valores de exemplo; explicação no README.md
# DJANGO_ALLOWED_HOSTS=api.alera.exemplo
# CORS_ALLOWED_ORIGINS=https://alera.exemplo
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.alera.exemplo
# DJANGO_NUM_PROXIES=0
# DJANGO_ATRAS_DA_CLOUDFLARE=true
# DJANGO_SECURE_SSL_REDIRECT=true