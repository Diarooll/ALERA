{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep *.env*)",
      "PowerShell(cat *.env*)",
      "PowerShell(type *.env*)",
      "PowerShell(gc *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Select-String *.env*)"
    ]
  }
}
